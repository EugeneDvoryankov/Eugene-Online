# Stage 1: Build frontend
FROM node:24-alpine AS client-builder
WORKDIR /app
COPY client/package*.json ./
RUN npm install
COPY client/ .
ARG VITE_API_URL=/api
RUN npm run build

# Stage 2: Build backend
FROM node:24-alpine AS server-builder
WORKDIR /app
COPY server/package*.json ./
RUN npm install
COPY server/ .
RUN npm run build

# Stage 3: Production image
FROM node:24-alpine AS production
WORKDIR /app

# Set to production for optimization
ENV NODE_ENV=production

# Copy built backend files and install only production dependencies
COPY --from=server-builder /app/dist ./dist
COPY --from=server-builder /app/package*.json ./
RUN npm ci --only=production

# Copy built frontend assets into the backend's public directory 
# (Assumes Express serves static files from 'public')
COPY --from=client-builder /app/dist ./public

# Expose the application port
EXPOSE 3000

# Start the server
CMD ["node", "dist/index.cjs"]
